BUCKET=audio-files
DB_CONNECTION_STRING=Host=...;Port=5432;Database=postgres;Username=...;Password=...;Ssl Mode=Require;Trust Server Certificate=true;
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
# Local models are provisioned automatically by `make init` and `make init-docker`.
FRONTEND_ORIGIN=http://localhost:5173
# Global limit on concurrent heavy external processes (FFmpeg, STT, LLM).
# Change and restart the container (no rebuild needed) to vary this between benchmark runs.
EXTERNAL_PROCESS_SEMAPHORE_LIMIT=3
# How often (seconds) the background service polls for Pending audios.
BACKGROUND_PROCESSING_POLL_INTERVAL_SECONDS=3
# Max number of whole audios processed concurrently by the background service.
# Change and restart the container (no rebuild needed) to vary this between benchmark runs.
BACKGROUND_PROCESSING_MAX_DEGREE_OF_PARALLELISM=3
