#!/bin/sh

# Git pre-push hook script to validate code quality before pushing.
# If any validation fails, the push is aborted.

echo "============================================="
echo "        Running Git Pre-Push Hook            "
echo "============================================="

echo ""
echo "Running project validation..."
echo ""

if ! make validate; then
    echo ""
    echo "============================================="
    echo "Error: Pre-push validation failed!"
    echo "Please fix the issues before pushing."
    echo "============================================="
    exit 1
fi

echo ""
echo "============================================="
echo "Pre-push validations passed successfully!"
echo "Proceeding with push."
echo "============================================="

exit 0